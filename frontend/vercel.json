{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/frontend/dist/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/dist/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/$1"
    }
  ]
}
